# The Odds API v4 key. Keep this on the server; never expose it as a VITE_ variable.
ODDS_API_KEY=your_api_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_SPORTS=basketball_nba,soccer_epl,americanfootball_nfl
PORT=3000
# Public chain RPC used only for balance reads.
RPC_URL=https://your-rpc-provider
# Deploy the contract and set this address in the browser's config.
BETTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
