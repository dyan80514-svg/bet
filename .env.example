# The Odds API v4 key. Keep this on the server; never expose it as a VITE_ variable.
ODDS_API_KEY=your_api_key_here
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_SPORTS=basketball_nba,soccer_epl,americanfootball_nfl
PORT=3000
PUBLIC_URL=https://your-production-domain.example
# Base mainnet RPC and USDC contract.
CHAIN_ID=8453
CHAIN_NAME=Base
RPC_URL=https://mainnet.base.org
TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BETTING_TOKENS=USDC:0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913:6,WETH:0x4200000000000000000000000000000000000006:18
# Set only after audited contract deployment. Empty means betting is unavailable.
BETTING_CONTRACT_ADDRESS=
# Production deployment only. Keep signer keys in a secure operator environment.
DEPLOYER_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=

RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000
