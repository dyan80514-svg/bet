{
  "name": "all-in-one-ton-betting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "dev": "concurrently -k -n backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "fetch:odds": "npm run fetch:odds --workspace backend",
    "check:reserve": "npm run check:reserve --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:push": "npm run db:push --workspace backend"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "engines": { "node": ">=20.19" }
}
